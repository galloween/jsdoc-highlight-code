{
    "name": "jsdoc-highlight-code",
    "displayName": "JSDoc syntax highlighting",
    "description": "Adds syntax highlighting to JSDoc comments (JS, TS, HTML, CSS, SCSS)",
    "version": "0.0.3",
    "publisher": "galloween",
    "license": "MIT",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#ffffff",
        "theme": "light"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/galloween/jsdoc-highlight-code.git"
    },
    "bugs": {
        "url": "https://github.com/galloween/jsdoc-highlight-code/issues"
    },
    "homepage": "https://github.com/galloween/jsdoc-highlight-code#readme",
    "engines": {
        "vscode": "^1.39.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "javascript",
        "typescript",
        "jsdoc",
        "comment",
        "markdown"
    ],
    "contributes": {
        "grammars": [
            {
                "scopeName": "documentation.injection.ts",
                "path": "./syntaxes/jsdoc.ts.injection.tmLanguage.json",
                "injectTo": [
                    "source.ts",
                    "source.tsx"
                ]
            },
            {
                "scopeName": "documentation.injection.js.jsx",
                "path": "./syntaxes/jsdoc.js.injection.tmLanguage.json",
                "injectTo": [
                    "source.js",
                    "source.js.jsx"
                ]
            }
        ]
    },
    "scripts": {
        "package": "npx --yes @vscode/vsce package"
    },
    "devDependencies": {
        "@vscode/vsce": "^3.2.0"
    }
}
